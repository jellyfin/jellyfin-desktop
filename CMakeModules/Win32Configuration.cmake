set(INSTALL_BIN_DIR .)
set(INSTALL_RESOURCE_DIR .)
set(HAVE_UPDATER 1)

# MSVC/Ninja cross-builds can retain the host's CMAKE_SYSTEM_PROCESSOR.
if(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
  set(_windows_target_arch "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
elseif(CMAKE_GENERATOR_PLATFORM)
  set(_windows_target_arch "${CMAKE_GENERATOR_PLATFORM}")
else()
  set(_windows_target_arch "${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(_windows_target_arch MATCHES "^(ARM64|arm64|aarch64)$")
  set(WINDOWS_ARCH arm64)
elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
  set(WINDOWS_ARCH x64)
else()
  set(WINDOWS_ARCH x86)
endif()

set(WINDOWS_DEPENDENCY_DIR "${PROJECT_SOURCE_DIR}/deps" CACHE PATH
    "Directory containing the Windows vcruntime folder and VC redistributable installer")

set(_mpv_d3d11_default OFF)
if(WINDOWS_ARCH STREQUAL "arm64")
  set(_mpv_d3d11_default ON)
endif()
option(USE_MPV_D3D11 "Render mpv with Direct3D 11 instead of OpenGL on Windows" ${_mpv_d3d11_default})
if(USE_MPV_D3D11)
  find_package(Qt6 6.7 REQUIRED COMPONENTS GuiPrivate)
  if(NOT EXISTS "${MPV_INCLUDE_DIR}/mpv/render_d3d11.h")
    message(FATAL_ERROR "USE_MPV_D3D11 requires libmpv 0.42 or newer with Direct3D 11 render API headers")
  endif()
  add_definitions(-DUSE_MPV_D3D11)
endif()

find_library(WINMM winmm)
find_library(IMMLIB imm32)
find_library(VERLIB version)
find_library(DWMLIB dwmapi)
find_library(AVRTLIB avrt)
find_library(POWRPROFLIB PowrProf)
find_library(RUNTIMEOBJECTLIB RuntimeObject)
set(OS_LIBS ${WINMM} ${IMMLIB} ${VERLIB} ${DWMLIB} ${AVRTLIB} ${POWRPROFLIB} ${RUNTIMEOBJECTLIB})
